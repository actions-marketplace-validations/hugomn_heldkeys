{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github", "--token", "${GITHUB_TOKEN}"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}" }
    },
    "remote": {
      "url": "https://mcp.example.com/mcp?api_key=${API_KEY}",
      "headers": { "Authorization": "Bearer ${input:token}" }
    }
  }
}
